  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 2aaa93f2aa9be4d4babad2427d4a3c02, type: 3}
  m_Name: Quiz_WineMaking
  m_EditorClassIdentifier: Assembly-CSharp::QuizBank
  moduleId: final-winemaking
  questions:
  - prompt: 'In winemaking, yeast converts sugar into ethanol and:'
    options:
    - Oxygen
    - Carbon dioxide
    - Methane
    - Water only
    correctIndex: 1
    explanation: Fermentation releases CO2.
  - prompt: 'Racking the wine means:'
    options:
    - Adding more sugar to restart fermentation
    - Decanting the clear wine off the sediment (lees)
    - Shaking the jar to mix the yeast back in
    - Boiling the wine to concentrate it
    correctIndex: 1
    explanation: Racking decants the clear wine off the lees without disturbing the sediment.
  - prompt: 'Evolved gas turning limewater milky confirms:'
    options:
    - Carbon dioxide is being produced
    - The wine is finished
    - Oxygen is present
    - The yeast is dead
    correctIndex: 0
    explanation: Milky limewater confirms carbon dioxide from fermentation.
