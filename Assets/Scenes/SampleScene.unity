  doorOpener: {fileID: 898115341}
  faceBehaviour: {fileID: 1579804415}
  tourGuide: {fileID: 1688781737}
  frontDoorSpawn: {fileID: 2108314338}
  playerRig: {fileID: 1464837115}
  cameraOverride: {fileID: 0}
  hudRig: {fileID: 637616415}
  supplyMonitor: {fileID: 191569887}
  postLab: {fileID: 1053408585}
  reviewCornerSpawn: {fileID: 1135736044}
  pharmeeBody: {fileID: 0}
  pharmeeReviewOffset: 1.15
  examiner: {fileID: 195455184}
  lines:
    approach: "Not so fast \u2014 the lab's still locked! What would you like to
      do today?"
    labTour: Lab Tour it is! Roam freely and try the tools and reagents. Come back
      to me when you want to take on a campaign.
    campaignExplain: The Campaign takes you through the class periods. Pass every
      experiment with 90% or better to unlock the next. Ready to pick one?
    episodePrompt: Which experiment will it be?
    lockedEpisode: "That one's still locked \u2014 clear the earlier experiments
      first!"
    coatPrompt: "Safety first! Gear up at the locker \u2014 lab coat, goggles and
      gloves, all three \u2014 before we begin."
    readyPrompt: All geared up! Are you prepared to begin?
    thresholdWarn: The period will start as soon as you walk in. Step through when
      you're ready!
    congrats: Congratulations! You handled that experiment brilliantly. Let's head
      back outside.
    supplyWarn: "Oh no \u2014 there isn't enough reagent left to finish the experiment.
      We'll have to restart the period."
    ppePartial: "Almost there \u2014 you're still missing a piece of your gear. Check
      the locker."
    ppeBlocked: "Hold on \u2014 I can't let you in without your full protective gear.
      The locker is right beside you."
    welcome: Welcome to the lab! I'm Pharmee. Come talk to me at the door whenever
      you're ready to begin.
  lineSeconds: 5.5
